# ── AI Provider ───────────────────────────────────────────────────────────────
# Which AI to use: "claude" or "openai"
REVIEW_PROVIDER=claude

ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-openai-key-here        # only needed if REVIEW_PROVIDER=openai

# ── GitHub ─────────────────────────────────────────────────────────────────────
# Personal Access Token with repo + write:discussion scopes
GITHUB_TOKEN=ghp_your-github-token-here

# Secret used to verify webhook payloads (set the same value in GitHub repo settings)
GITHUB_WEBHOOK_SECRET=your-random-secret-here
